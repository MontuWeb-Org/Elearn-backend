# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# CORS: comma-separated list of allowed origins, or * for any
CORS_ORIGIN=*

# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://elearn:elearn@localhost:5433/elearn_dev?schema=public"

# HS256 signing key for access JWTs. Use a long random string in every environment.
JWT_SECRET=change-me-to-a-random-32-byte-secret

# bcrypt cost factor for USERS.password_hash. Spec requires 12.
BCRYPT_ROUNDS=12

# Path to a PEM CA bundle, for providers using a private root CA.
# Supabase: certs/supabase-prod-ca-2021.crt (committed). Leave unset for local
# Postgres or any provider whose chain is signed by a public root.
# DATABASE_CA_CERT=certs/supabase-prod-ca-2021.crt

# GitBook — publishing docs/api/openapi.yaml.
# Token: app.gitbook.com/account/developer
# Organization id: the /o/... segment in any app.gitbook.com URL
#   (this org: DaDQkGCM7r2TghFSBFLQ)
GITBOOK_TOKEN=
GITBOOK_ORGANIZATION_ID=
GITBOOK_SPEC_NAME=montu-api
