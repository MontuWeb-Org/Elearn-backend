# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# CORS: comma-separated list of allowed origins, or * for any
CORS_ORIGIN=*

# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://elearn:elearn@localhost:5432/elearn_dev?schema=public"

# Path to a PEM CA bundle, for providers using a private root CA.
# Supabase: certs/supabase-prod-ca-2021.crt (committed). Leave unset for local
# Postgres or any provider whose chain is signed by a public root.
# DATABASE_CA_CERT=certs/supabase-prod-ca-2021.crt
